Перем ЭтоЛямбдаВыражение;      // Кеш регулярного выражения лямбда выражения
Перем СодержитВозвратЗначения; // Кеш регулярного выражения содержит возврат значения
Перем ОбъявлениеПеременных;    // Кеш регулярного выражения объявления переменных в начале тела

Перем КешСозданныхЛямбд; // LRU кеш созданных лямбд
Перем Блокировка; // Блокировка кеша

Функция РегулярноеВыражениеЭтоЛямбдаВыражение() Экспорт
	Возврат ЭтоЛямбдаВыражение;
КонецФункции

Функция РегулярноеВыражениеСодержитВозвратЗначения() Экспорт
	Возврат СодержитВозвратЗначения;
КонецФункции

Функция РегулярноеВыражениеОбъявлениеПеременных() Экспорт
	Возврат ОбъявлениеПеременных;
КонецФункции

// Возвращает объект лямбды, созданный с теми же значениями контекста.
//
// Параметры:
//   Выражение - Строка - Лямбда выражение
//   Интерфейс - ИнтерфейсОбъекта - Функциональный интерфейс лямбды
//   Контекст - Структура, ФиксированнаяСтруктура, Неопределено - Контекст лямбды
//   ЗахватываемыйОбъект - Произвольный - Захваченный объект
//
//  Возвращаемое значение:
//   Сценарий, Неопределено - Объект лямбды из кеша
//
Функция ДостатьИзКеша(Выражение, Интерфейс, Контекст, ЗахватываемыйОбъект) Экспорт

	ИменаПолейКонтекста = ИменаПолейКонтекста(Контекст);
	Строка              = Неопределено;

	Блокировка.Заблокировать();
	Попытка

		Строки = КешСозданныхЛямбд.НайтиСтроки(
			Новый Структура(
				"Выражение, Интерфейс, ИменаПолейКонтекста, ЗахватываемыйОбъект",
				Выражение,
				Интерфейс,
				ИменаПолейКонтекста,
				ЗахватываемыйОбъект
			)
		);

		Для Каждого Кандидат Из Строки Цикл
			Если ЗначенияКонтекстаСовпадают(Контекст, Кандидат.Контекст) Тогда
				Строка = Кандидат;
				Прервать;
			КонецЕсли;
		КонецЦикла;

		Если Строка = Неопределено Тогда
			Блокировка.Разблокировать();
			Возврат Неопределено;
		КонецЕсли;

		КешСозданныхЛямбд.Сдвинуть(Строка, -КешСозданныхЛямбд.Индекс(Строка));

	Исключение
		Блокировка.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;

	Блокировка.Разблокировать();

	Возврат Строка.Объект;

КонецФункции

// Кладет объект лямбды в кеш.
//
// Параметры:
//   Выражение - Строка - Лямбда выражение
//   Интерфейс - ИнтерфейсОбъекта - Функциональный интерфейс лямбды
//   СнимокКонтекста - ФиксированнаяСтруктура, Неопределено - Снимок контекста, который хранит объект лямбды
//   ЗахватываемыйОбъект - Произвольный - Захваченный объект
//   Объект - Сценарий - Объект лямбды
//
Процедура ПоложитьВКеш(Выражение, Интерфейс, СнимокКонтекста, ЗахватываемыйОбъект, Объект) Экспорт

	ИменаПолейКонтекста = ИменаПолейКонтекста(СнимокКонтекста);

	Блокировка.Заблокировать();
	Попытка
		Строка = КешСозданныхЛямбд.Вставить(0);
		Строка.Выражение           = Выражение;
		Строка.Интерфейс           = Интерфейс;
		Строка.ИменаПолейКонтекста = ИменаПолейКонтекста;
		Строка.Контекст            = СнимокКонтекста;
		Строка.ЗахватываемыйОбъект = ЗахватываемыйОбъект;
		Строка.Объект              = Объект;

		Если КешСозданныхЛямбд.Количество() > 50 Тогда
			КешСозданныхЛямбд.Удалить(КешСозданныхЛямбд.Количество() - 1);
		КонецЕсли;
	Исключение
		Блокировка.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;

	Блокировка.Разблокировать();

КонецПроцедуры

Функция ИменаПолейКонтекста(Контекст)

	Если Не ЗначениеЗаполнено(Контекст) Тогда
		Возврат "";
	КонецЕсли;

	ИменаПолей = Новый Массив();

	Для Каждого ПеременнаяИЗначение Из Контекст Цикл
		ИменаПолей.Добавить(ПеременнаяИЗначение.Ключ);
	КонецЦикла;

	Возврат СтрСоединить(ИменаПолей, ",");

КонецФункции

// Сравнивает значения контекста со снимком, у которого те же имена полей.
// Значения сравниваются вместе с типом: примитивы по значению, объекты по ссылке.
//
Функция ЗначенияКонтекстаСовпадают(Контекст, СнимокКонтекста)

	Если Не ЗначениеЗаполнено(Контекст) Тогда
		Возврат Истина;
	КонецЕсли;

	Для Каждого ПеременнаяИЗначение Из Контекст Цикл

		ЗначениеСнимка = СнимокКонтекста[ПеременнаяИЗначение.Ключ];

		Если ТипЗнч(ЗначениеСнимка) <> ТипЗнч(ПеременнаяИЗначение.Значение)
			Или ЗначениеСнимка <> ПеременнаяИЗначение.Значение Тогда
			Возврат Ложь;
		КонецЕсли;

	КонецЦикла;

	Возврат Истина;

КонецФункции

ЭтоЛямбдаВыражение      =Новый РегулярноеВыражение("((?:\s|\S)*?)->\s*([\s\S]*)");
СодержитВозвратЗначения = Новый РегулярноеВыражение("(?>[^\S]+|^)(Возврат)\s+[^;\s]+\s*;?");
ОбъявлениеПеременных    = Новый РегулярноеВыражение("(?i)\G(?:\s|//[^\n]*)*(?:Перем|Var)\s+([^;]+);");

КешСозданныхЛямбд = Новый ТаблицаЗначений();
КешСозданныхЛямбд.Колонки.Добавить("Выражение");
КешСозданныхЛямбд.Колонки.Добавить("Интерфейс");
КешСозданныхЛямбд.Колонки.Добавить("ИменаПолейКонтекста");
КешСозданныхЛямбд.Колонки.Добавить("Контекст");
КешСозданныхЛямбд.Колонки.Добавить("ЗахватываемыйОбъект");
КешСозданныхЛямбд.Колонки.Добавить("Объект");

Блокировка = Новый БлокировкаРесурса();
